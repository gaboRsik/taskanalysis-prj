PATCH http://localhost:8080/api/tasks/36/status
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJ0ZXN0MkBleGFtcGxlLmNvbSIsImlhdCI6MTc3OTEwMzYwNiwiZXhwIjoxNzc5MTA3MjA2fQ.uoT1d0zH-dv0I8Zw6Z8Jt4dCw0HGYkO5faTq6xVgo_AM_T0T5Itrik62qpSDJHpvQzAUYhwrIkL1s5ls7y3qQw

